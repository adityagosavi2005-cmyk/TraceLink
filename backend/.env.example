# TraceLink backend — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# DATABASE_URL uses the psycopg v3 driver, e.g.:
#   postgresql+psycopg://USER:PASSWORD@localhost:5432/tracelink

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/tracelink
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Phase 1 object storage (S3-compatible). Local dev: MinIO, e.g.
#   S3_ENDPOINT_URL=http://localhost:9000
#   S3_ACCESS_KEY=minioadmin
#   S3_SECRET_KEY=minioadmin
# Production: bucket endpoint + IAM credentials; leave S3_ENDPOINT_URL
# empty only when using real AWS S3 in S3_REGION.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=tracelink-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
PRESIGNED_URL_TTL_SECONDS=600
PHOTO_MAX_BYTES=10485760

# Phase 4 face detection (YuNet). Weights are model infrastructure:
# keep them on the server filesystem, NEVER in the evidence bucket.
#FACE_DETECTOR_NAME=yunet
#FACE_DETECTOR_VERSION=2023mar
#FACE_DETECTION_THRESHOLD=0.6
#YUNET_MODEL_PATH=./app/assets/face_detection_yunet_2023mar.onnx

# Phase 5 face representation (SFace). Weights are model
# infrastructure: keep them on the server filesystem, NEVER in the
# evidence bucket.
#FACE_REPRESENTATION_NAME=sface
#FACE_REPRESENTATION_VERSION=2021dec
#SFACE_MODEL_PATH=./app/assets/face_recognition_sface_2021dec.onnx

# Phase 7 image enhancement (Real-ESRGAN x4). Optional: the API runs
# without it; enhancement attempts fail closed until torch plus the
# weights below are installed (see requirements-enhancement.txt).
# Weights are model infrastructure: keep them on the server
# filesystem, NEVER in the evidence bucket, NEVER commit to Git.
#ENHANCER_NAME=realesrgan
#ENHANCER_VERSION=v1
#ENHANCER_MODEL_NAME=RealESRGAN_x4plus
#ENHANCER_MODEL_VERSION=v0.1.0
#ENHANCER_MODEL_PATH=./app/assets/RealESRGAN_x4plus.pth
#ENHANCER_DEVICE=cpu
#ENHANCEMENT_SCALE=4
#ENHANCEMENT_MAX_INPUT_PIXELS=2097152

# Phase 8 face restoration (GFPGAN). Optional: the API runs
# without it; restoration attempts fail closed until torch, the
# gfpgan stack (see requirements-restoration.txt), and the weights
# below are installed. Weights are model infrastructure: keep them
# on the server filesystem, NEVER in the evidence bucket, NEVER
# commit to Git. Auxiliary facexlib weights must be pre-seeded at
# backend/gfpgan/weights/ when serving from backend/ (see
# backend/app/assets/README.md); missing files fail closed, never
# download at request time.
#RESTORER_NAME=gfpgan
#RESTORER_VERSION=v1
#GFPGAN_MODEL_NAME=GFPGANv1.3
#GFPGAN_MODEL_VERSION=v1.3
#GFPGAN_MODEL_PATH=./app/assets/GFPGANv1.3.pth
#RESTORER_DEVICE=cpu
#RESTORATION_MAX_FACE_PIXELS=1048576
